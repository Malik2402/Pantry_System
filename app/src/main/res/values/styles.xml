<resources>
    <style name="Theme.SmartPantry" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/forest</item>
        <item name="colorPrimaryDark">@color/forest</item>
        <item name="colorAccent">@color/forest</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColorLink">@color/forest</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Heading">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Body">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>
    <style name="PantryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/surface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="PantryButton.Secondary">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/forest</item>
    </style>
    <style name="PantryButton.Text">
        <item name="android:background">@drawable/button_text</item>
        <item name="android:textColor">@color/forest</item>
    </style>
    <style name="PantryButton.Delete" parent="PantryButton.Text">
        <item name="android:textColor">@color/danger</item>
    </style>
    <style name="PantryField" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/home_search</item>
        <item name="backgroundTint">@null</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>
</resources>
