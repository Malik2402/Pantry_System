<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:orientation="vertical" android:padding="14dp" android:background="@drawable/card_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<ImageView android:id="@+id/recipe_art" android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/recipe_art_frame" android:scaleType="centerCrop" android:importantForAccessibility="no" />
<TextView android:id="@+id/recipe_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/ink" />
</LinearLayout>
<TextView android:id="@+id/recipe_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="10dp" android:background="@drawable/home_sage" android:textSize="14sp" android:textColor="@color/forest" />
<Button style="@style/PantryButton.Secondary" android:id="@+id/open_recipe" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/ui_view_recipe" />
</LinearLayout>
