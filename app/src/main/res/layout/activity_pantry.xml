<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Use what you have." style="@style/Heading" />
<TextView android:id="@+id/pantry_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" style="@style/Body" />
<Button android:id="@+id/add_ingredient" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Add ingredient" />
<TextView android:id="@+id/pantry_feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:paddingVertical="8dp" style="@style/Body" android:visibility="gone" />
<TextView android:id="@+id/pantry_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="24dp" android:text="Your pantry is empty.\nAdd your first ingredient to get started." style="@style/Body" />
<androidx.recyclerview.widget.RecyclerView android:id="@+id/pantry_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="12dp" />
</LinearLayout>
