<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/detail_name" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Heading" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/ui_ingredients" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/detail_availability" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:layout_marginTop="12dp" android:background="@drawable/home_peach" android:textColor="@color/ink" android:textSize="16sp" android:visibility="gone" />
        <TextView android:id="@+id/detail_ingredients" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:lineSpacingExtra="6dp" style="@style/Body" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/ui_method" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/detail_steps" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:lineSpacingExtra="8dp" style="@style/Body" />
        <Button style="@style/PantryButton.Secondary" android:id="@+id/detail_back" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/ui_back_to_suggestions" />
    </LinearLayout>
</ScrollView>
