<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:background="@drawable/home_sage">
<ImageView android:id="@+id/detail_art" android:layout_width="96dp" android:layout_height="96dp" android:background="@drawable/recipe_art_frame" android:scaleType="centerCrop" android:importantForAccessibility="no" />
<TextView android:id="@+id/detail_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" style="@style/Heading" android:textColor="@color/forest" />
</LinearLayout>
<TextView android:id="@+id/detail_availability" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:layout_marginTop="12dp" android:background="@drawable/home_peach" android:textColor="@color/ink" android:textSize="16sp" android:visibility="gone" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp" android:padding="18dp" android:background="@drawable/card_background">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_ingredients" android:textColor="@color/forest" android:textSize="20sp" android:textStyle="bold" />
<TextView android:id="@+id/detail_ingredients" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:lineSpacingExtra="6dp" style="@style/Body" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp" android:padding="18dp" android:background="@drawable/card_background">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_method" android:textColor="@color/forest" android:textSize="20sp" android:textStyle="bold" />
<TextView android:id="@+id/detail_steps" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:lineSpacingExtra="8dp" style="@style/Body" />
</LinearLayout>
<Button style="@style/PantryButton.Secondary" android:id="@+id/detail_back" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/ui_back_to_suggestions" />
</LinearLayout></ScrollView>
