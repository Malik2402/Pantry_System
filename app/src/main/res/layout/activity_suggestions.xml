<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ready to cook" style="@style/Heading" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Every ingredient. Enough of each. These recipes fit your pantry right now." style="@style/Body" />
<TextView android:id="@+id/recipe_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="16dp" style="@style/Body" android:accessibilityLiveRegion="polite" />
<TextView android:id="@+id/recipes_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="24dp" android:text="No recipes match your pantry yet—add more ingredients." style="@style/Body" />
<androidx.recyclerview.widget.RecyclerView android:id="@+id/recipe_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="12dp" />
</LinearLayout>
