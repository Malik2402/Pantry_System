<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shell" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/cream">
    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/forest" android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />
    <FrameLayout android:id="@+id/screen_container" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
