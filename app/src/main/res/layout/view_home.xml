<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/home_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:focusableInTouchMode="true" android:clipToPadding="false">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="16dp" android:paddingBottom="20dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
<ImageView android:layout_width="46dp" android:layout_height="46dp" android:src="@drawable/recipe_logo" android:contentDescription="@string/logo_description" />
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_brand" android:textColor="@color/forest" android:textSize="23sp" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_brand_subtitle" android:letterSpacing="0.24" android:textColor="@color/muted" android:textSize="11sp" android:textStyle="bold" />
</LinearLayout></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/home_welcome" android:textColor="@color/ink" android:textSize="29sp" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/home_tagline" android:textColor="@color/muted" android:textSize="16sp" />
<EditText android:id="@+id/home_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="54dp" android:layout_marginTop="20dp" android:background="@drawable/home_search" android:paddingHorizontal="14dp" android:paddingVertical="12dp" android:drawableStart="@drawable/home_search_icon" android:drawablePadding="12dp" android:hint="@string/home_search_hint" android:inputType="text" android:importantForAutofill="no" android:imeOptions="actionSearch" android:maxLines="1" android:textSize="14sp" android:textColor="@color/ink" android:textColorHint="@color/muted" />
<TextView android:id="@+id/home_feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" android:textColor="@color/forest" android:visibility="gone" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp" android:padding="16dp" android:background="@drawable/home_sage">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_at_glance" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/forest" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
<LinearLayout android:id="@+id/home_pantry_stat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
<ImageView android:layout_width="30dp" android:layout_height="36dp" android:src="@drawable/home_jar_icon" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
<TextView android:id="@+id/home_item_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/forest" android:textSize="28sp" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_items" android:textSize="13sp" android:textColor="@color/muted" />
</LinearLayout></LinearLayout>
<LinearLayout android:id="@+id/home_expiry_stat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
<ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/home_clock_icon" app:tint="#AF4B13" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp">
<TextView android:id="@+id/home_expiry_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/forest" android:textSize="28sp" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_expiring_soon" android:textSize="13sp" android:textColor="@color/muted" />
</LinearLayout></LinearLayout></LinearLayout></LinearLayout>
<LinearLayout android:id="@+id/home_pantry_results" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="16dp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp">
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/ui_suggested_recipes" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/ink" />
<TextView android:id="@+id/home_view_all" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="0dp" android:text="@string/home_view_all" android:textSize="14sp" android:textColor="@color/forest" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" />
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/home_recipes_subtitle" android:textColor="@color/muted" android:textSize="14sp" />
<TextView android:id="@+id/home_recipes_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="110dp" android:padding="20dp" android:gravity="center" android:background="@drawable/home_card" android:text="@string/ui_no_recipes_match_your_pantry_yet_add_more_ingredients" android:textSize="16sp" android:textColor="@color/muted" />
<androidx.recyclerview.widget.RecyclerView android:id="@+id/home_recipe_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:clipToPadding="false" android:paddingTop="2dp" />
<LinearLayout android:id="@+id/home_expiry_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="78dp" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/home_peach" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
<ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/home_clock_icon" app:tint="#AF4B13" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginHorizontal="14dp">
<TextView android:id="@+id/home_expiry_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_use_soon" android:textColor="#A34510" android:textSize="17sp" android:textStyle="bold" />
<TextView android:id="@+id/home_expiry_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/muted" android:textSize="14sp" />
</LinearLayout><ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/home_arrow_icon" android:importantForAccessibility="no" />
</LinearLayout>
<androidx.appcompat.widget.AppCompatButton android:id="@+id/home_add_ingredient" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="54dp" android:layout_marginTop="16dp" android:background="@drawable/home_green" android:text="@string/home_add_item" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:textAllCaps="false" />
</LinearLayout></ScrollView>