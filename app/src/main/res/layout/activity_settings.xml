        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_highlight_ingredients_that_expire_within_7_days_or_have_passed_th" style="@style/Body" />
        <TextView android:id="@+id/settings_feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" style="@style/Body" android:accessibilityLiveRegion="polite" />
