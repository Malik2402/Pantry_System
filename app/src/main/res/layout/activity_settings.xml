        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/ui_track_your_ingredients_and_find_recipes_you_can_make_with_what_yo" style="@style/Body" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:autoLink="web" android:text="@string/ui_https_github_com_malik2402_pantry_system" style="@style/Body" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:autoLink="web" android:text="@string/logo_credit" style="@style/Body" />
    </LinearLayout>
